<Project>
  <PropertyGroup>
    <!-- Update this value, CHANGELOG.md, and the tag together for each release. -->
    <AgendaVersion>0.4.0</AgendaVersion>
    <Version>$(AgendaVersion)</Version>
    <AssemblyVersion>$(AgendaVersion).0</AssemblyVersion>
    <FileVersion>$(AgendaVersion).0</FileVersion>
    <InformationalVersion>$(AgendaVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).packages</RestorePackagesPath>
    <NuGetAudit>true</NuGetAudit>
  </PropertyGroup>
</Project>
