<Window x:Class="Agenda.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" KeyDown="Root_KeyDown" Background="Transparent">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
    <Grid Padding="20,18" ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="ClockText" FontSize="28"/><TextBlock x:Name="DateText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
     <Button Grid.Column="1" x:Name="CollapseButton" Click="Collapse_Click" VerticalAlignment="Center" AutomationProperties.Name="Collapse calendar"><FontIcon Glyph="&#xE70D;" FontSize="12"/></Button>
    </Grid>
    <StackPanel x:Name="CalendarPanel" Grid.Row="1" Padding="12,0,12,12" Background="Transparent">
     <Grid Margin="4,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="MonthText" VerticalAlignment="Center" FontWeight="SemiBold"/>
      <Button Grid.Column="1" Click="Previous_Click" AutomationProperties.Name="Previous month" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE70E;" FontSize="12"/></Button>
      <Button Grid.Column="2" Click="Next_Click" AutomationProperties.Name="Next month" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE70D;" FontSize="12"/></Button>
     </Grid>
     <Grid x:Name="MonthGrid"/>
    </StackPanel>
    <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" IsClosable="True" Margin="12,0,12,8"/>
    <Grid x:Name="AgendaPanel" Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,8,16,4" RowSpacing="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="SelectedDateText" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Click="PreviousDay_Click" AutomationProperties.Name="Previous day" ToolTipService.ToolTip="Previous day" Width="32" MinWidth="0" Padding="6" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE76B;" FontSize="12"/></Button>
      <Button Grid.Column="2" Content="Today" Click="Today_Click" Background="Transparent" BorderThickness="0"/>
      <Button Grid.Column="3" Click="NextDay_Click" AutomationProperties.Name="Next day" ToolTipService.ToolTip="Next day" Width="32" MinWidth="0" Padding="6" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE76C;" FontSize="12"/></Button>
     </Grid>
     <ScrollViewer x:Name="AgendaScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" ViewChanged="AgendaScroll_ViewChanged" SizeChanged="AgendaScroll_SizeChanged" AutomationProperties.Name="Events for selected day">
      <StackPanel SizeChanged="AgendaScroll_SizeChanged">
       <StackPanel x:Name="EmptyPanel" Padding="4,12,4,16" Spacing="10">
      <TextBlock x:Name="EmptyTitle" Text="Your day, at a glance" FontSize="18"/>
      <TextBlock x:Name="EmptyMessage" Text="Add an iCalendar feed from Google, Outlook, or another calendar service, or use a local .ics file." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Button x:Name="ConnectButton" Content="Add iCalendar feeds" Click="Feeds_Click" Style="{StaticResource AccentButtonStyle}"/>
     </StackPanel>
       <StackPanel x:Name="EventList" Spacing="2"/>
      </StackPanel>
     </ScrollViewer>
     <!-- Keep the cue's space reserved so reaching the bottom cannot resize the viewport. -->
     <Button x:Name="MoreEventsButton" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="18" Padding="10,0" Background="Transparent" BorderThickness="0" Click="MoreEvents_Click" AutomationProperties.Name="Scroll to more events below">
      <StackPanel Orientation="Horizontal" Spacing="6">
       <TextBlock Text="More events below" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
     </Button>
    </Grid>
   <Grid Grid.Row="3">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="AuxiliaryScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
    <StackPanel x:Name="CalendarsPanel" Visibility="Collapsed" Padding="16,12" Spacing="12">
     <TextBlock Text="Calendars" FontSize="20"/>
     <TextBlock x:Name="AccountText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <StackPanel x:Name="CalendarList"/>
    </StackPanel>
    <StackPanel x:Name="EditorPanel" Visibility="Collapsed" Padding="16,12" Spacing="12">
     <Grid><TextBlock Text="New event" FontSize="20"/><Button HorizontalAlignment="Right" Content="Cancel" Click="Back_Click"/></Grid>
     <TextBox x:Name="EventTitle" Header="Title" PlaceholderText="Add an event"/>
     <ComboBox x:Name="EventCalendar" Header="Calendar" HorizontalAlignment="Stretch" DisplayMemberPath="Name"/>
     <DatePicker x:Name="EventDate" Header="Date" HorizontalAlignment="Stretch"/>
     <ToggleSwitch x:Name="AllDayToggle" Header="All day" Toggled="AllDay_Toggled"/>
     <TimePicker x:Name="StartTime" Header="Start" HorizontalAlignment="Stretch"/>
     <TimePicker x:Name="EndTime" Header="End" HorizontalAlignment="Stretch"/>
     <TextBox x:Name="EventLocation" Header="Location" PlaceholderText="Add a location"/>
     <TextBox x:Name="EventNotes" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap"/>
     <Button x:Name="SaveButton" Content="Save" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"/>
    </StackPanel>
    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Padding="16,12" Spacing="14">
     <TextBlock Text="Settings" FontSize="20"/>
     <ToggleSwitch x:Name="WeekToggle" Header="Show week numbers" Toggled="Preferences_Changed"/>
     <ToggleSwitch x:Name="IsoToggle" Header="Use ISO week numbering" Toggled="Preferences_Changed"/>
     <TextBlock Text="ISO uses Monday and the first four-day week. Otherwise, Windows regional settings apply." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
     <TextBlock x:Name="RegionText" TextWrapping="Wrap" FontSize="12"/>
     <!-- Keep other providers implemented, but remove their setup from the current UI. -->
     <Button Content="Use Windows calendars" Click="WindowsCalendars_Click" Visibility="Collapsed"/>
     <StackPanel Orientation="Horizontal" Spacing="8" Visibility="Collapsed"><HyperlinkButton Content="Google Calendar" Click="GoogleCalendar_Click"/><HyperlinkButton Content="Outlook.com" Click="OutlookCalendar_Click"/></StackPanel>
     <Button Content="Microsoft sign-in (requires app ID)" Click="Connect_Click" Visibility="Collapsed"/>
     <Button x:Name="SignOutButton" Content="Disconnect active source" Click="SignOut_Click" Visibility="Collapsed"/>
     <HyperlinkButton Content="Windows account settings" Click="WindowsAccounts_Click" Visibility="Collapsed"/>
     <Expander Header="Developer setup" HorizontalAlignment="Stretch" Visibility="Collapsed">
      <StackPanel Spacing="10">
       <TextBlock Text="This development build needs its own Microsoft application registration. This is a one-time setup for the app publisher." TextWrapping="Wrap" FontSize="12"/>
       <TextBox x:Name="ClientIdBox" Header="Application (client) ID" PlaceholderText="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
       <Button Content="Save application ID" Click="SaveClientId_Click"/>
       <HyperlinkButton Content="Microsoft registration guide" Click="Registration_Click"/>
      </StackPanel>
     </Expander>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
    <Grid x:Name="FeedsPanel" Visibility="Collapsed" Padding="16,12" RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Calendar feeds" FontSize="20"/>
     <ListView x:Name="FeedList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False"
      CanDragItems="True" CanReorderItems="True" AllowDrop="True"
      DragItemsStarting="FeedList_DragItemsStarting" DragItemsCompleted="FeedList_DragItemsCompleted"
      KeyDown="FeedList_KeyDown"
      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      AutomationProperties.Name="Calendar feeds">
      <ListView.ItemContainerStyle>
       <Style TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="MinHeight" Value="36"/>
       </Style>
      </ListView.ItemContainerStyle>
     </ListView>
     <StackPanel Grid.Row="2" Spacing="12">
     <Button x:Name="AddFeedButton" Content="Add calendar feed" Click="AddFeed_Click" Style="{StaticResource AccentButtonStyle}"/>
     <HyperlinkButton Content="Find Google’s secret iCal address" Click="GoogleFeedHelp_Click"/>
     <HyperlinkButton Content="Publish an Outlook.com ICS link" Click="OutlookFeedHelp_Click"/>
     <TextBlock Text="Feeds refresh periodically; changes may take time to appear. A local file is a snapshot until you replace it. Outlook published calendars are accessible to anyone holding the link." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel>
    </Grid>
   <TextBlock x:Name="VersionText" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Right" Margin="16,8,16,12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" AutomationProperties.Name="Application version"/>
   </Grid>
  <Grid Grid.Row="4" Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="CalendarsButton" Content="Calendars" Click="Calendars_Click" Background="Transparent" BorderThickness="0"/>
   <TextBlock x:Name="SyncText" Grid.Column="1" Text="Not connected" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="6,0"/>
   <Button x:Name="RefreshButton" Grid.Column="2" Click="Refresh_Click" AutomationProperties.Name="Refresh calendars" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
   <Button x:Name="ManageFeedsButton" Grid.Column="3" Click="ManageFeeds_Click" AutomationProperties.Name="Manage calendar feeds" ToolTipService.ToolTip="Manage calendar feeds" Background="Transparent" BorderThickness="0">
    <!-- Vector rendering of the tray calendar's outline, bindings and two agenda lines. -->
    <Path Width="16" Height="16" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1" Data="M2,2.5 H14 Q15.5,2.5 15.5,4 V14 Q15.5,15.5 14,15.5 H2 Q0.5,15.5 0.5,14 V4 Q0.5,2.5 2,2.5 M0.5,5.5 H15.5 M4.5,0 V3.5 M11.5,0 V3.5 M5,9.5 H12 M5,12.5 H9"/>
   </Button>
   <Button x:Name="SettingsButton" Grid.Column="4" Click="Settings_Click" AutomationProperties.Name="Settings" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE713;" FontSize="14"/></Button>
  </Grid>
  <ContentDialog x:Name="AddFeedDialog" Title="Add calendar feed" PrimaryButtonText="Add" CloseButtonText="Cancel" DefaultButton="Primary" PrimaryButtonClick="AddFeedDialog_PrimaryButtonClick">
   <StackPanel Spacing="12">
    <InfoBar x:Name="FeedErrorBar" IsOpen="False" IsClosable="False" Severity="Warning"/>
    <TextBox x:Name="FeedNameBox" Header="Calendar name" PlaceholderText="Personal calendar"/>
    <PasswordBox x:Name="FeedLocationBox" Header="Secret ICS link or full file path" PlaceholderText="https://… or C:\…\calendar.ics" PasswordRevealMode="Peek"/>
    <TextBox x:Name="FeedWebsiteBox" Header="Calendar website (optional)" PlaceholderText="Automatic for Google and Outlook"/>
    <StackPanel Spacing="6">
     <TextBlock Text="Feed color"/>
     <StackPanel x:Name="FeedColorPicker" AutomationProperties.Name="Feed color"/>
    </StackPanel>
    <TextBlock Text="Links can grant access to calendar details. Keep them private; Agenda encrypts saved links for your Windows user." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </StackPanel>
  </ContentDialog>
 </Grid>
</Window>
